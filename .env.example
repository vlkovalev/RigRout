# Copy this file to .env and fill in whichever keys you actually have.
# rigrout-server.js loads .env automatically at startup if it exists (see the
# top of that file) — no extra package needed. Nothing here is required to
# run the server; every value below is optional and the feed/feature it
# controls simply won't be enabled without it.

# ── Deployment ────────────────────────────────────────────────────────────
# Uncomment and set to 0.0.0.0 when deploying somewhere real (Render/Fly/a
# VPS) so the server accepts connections from outside the machine. Leave
# unset (defaults to 127.0.0.1, loopback-only) for local development.
# HOST=0.0.0.0

# Most hosts inject PORT automatically — only set this if yours doesn't.
# PORT=3001

# Required for production operator access to GET /api/feedback,
# /api/cache/clear, and /api/restart. Use a long random value and send it as:
# Authorization: Bearer <token>
# ADMIN_TOKEN=

# Optional comma-separated origins allowed when the UI and API are hosted on
# different domains. Same-origin requests work without this setting.
# ALLOWED_ORIGINS=https://app.example.com

# ── Optional supplemental incident feed ──────────────────────────────────
# TomTom enables commercial truck routing and supplements live traffic with
# accidents/roadwork/closures across North America. It does not replace the
# state seasonal weight-restriction feeds below.
# TOMTOM_API_KEY=

# ── Optional per-state 511/IBI developer keys ────────────────────────────
# These states' 511 feeds are gated behind a free registered developer key.
# See README.md "Live road ban feeds" for the registration link for each.
# BAN_KEY_ID=
# BAN_KEY_WY=
# BAN_KEY_WI=
# BAN_KEY_OH=
# BAN_KEY_UT=
